{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jo-follow-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}